# ---- JARVIS configuration (copy to .env or export in your shell) ----

# Port and bind address. JARVIS binds to localhost unless JARVIS_API_TOKEN is set.
PORT=3000
HOST=127.0.0.1

# Secret used to derive the AES-256-GCM key that encrypts all data at rest.
# If unset, JARVIS creates a random key file (data/.key, mode 0600) on first run.
# To manage the key yourself, generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JARVIS_SECRET=

# Optional bearer token required by the HTTP API and dashboard. Set this before
# exposing JARVIS beyond localhost.
# JARVIS_API_TOKEN=

# Where JARVIS stores its data files (default: ./data)
# JARVIS_DATA_DIR=./data

# ---- Natural language (optional, enables open-ended conversation) ----
# Without a key JARVIS still handles commands with its built-in rule engine.
# ANTHROPIC_API_KEY=sk-ant-...
# JARVIS_LLM_MODEL=claude-opus-5-5
# JARVIS_LLM_EFFORT=low            # low | medium | high | xhigh | max

# ---- Voice (optional) ----
# Without a key JARVIS uses the browser's built-in speech.
# With one, it speaks with a natural ElevenLabs voice and can transcribe speech in any browser.
# ELEVENLABS_API_KEY=sk_...
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb   # "George"; any voice id from your ElevenLabs account
# ELEVENLABS_MODEL=eleven_flash_v2_5         # low-latency speech
# ELEVENLABS_STT_MODEL=scribe_v2

# ---- Smart home adapters (optional; the simulated adapter is on by default) ----
# JARVIS_SMARTHOME_ADAPTER=simulated   # simulated | homeassistant | hue
# HOMEASSISTANT_URL=http://homeassistant.local:8123
# HOMEASSISTANT_TOKEN=
# HUE_BRIDGE_URL=http://192.168.1.2
# HUE_USERNAME=

# ---- Calendar (optional) ----
# JARVIS_CALENDAR_ADAPTER=local        # local | google
# GOOGLE_CALENDAR_ACCESS_TOKEN=
# GOOGLE_CALENDAR_ID=primary

# ---- Social / messaging (optional) ----
# MASTODON_URL=https://mastodon.social
# MASTODON_TOKEN=
# WEBHOOK_URL=                         # Slack / Discord incoming webhook

# ---- Privacy ----
# JARVIS_RETENTION_DAYS=30             # conversation history retention
# JARVIS_DEFAULT_LOCATION=London
# JARVIS_ALLOWED_HOSTS=jarvis.local   # extra host names allowed without a token
# JARVIS_NEWS_FEEDS=https://example.com/rss.xml
